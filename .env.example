# PostgreSQL ulanish satri — kompyuterda ishlash uchun.
# Docker compose bilan ishga tushirilganda bu qiymat ishlatilmaydi:
# u yerda manzilni compose o'zi beradi (`db` xizmati). Tashqi bazaga
# ulanish kerak bo'lsa COMPOSE_DATABASE_URL qo'yiladi.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/onebofx?schema=public"

# Sessiya imzosi uchun maxfiy kalit (kamida 32 belgi).
# Yaratish: openssl rand -base64 32
AUTH_SECRET="bu-yerga-uzun-tasodifiy-satr-qoying-kamida-32-belgi"

# Skrinshotdan o'qish uchun (ixtiyoriy — bo'lmasa funksiya o'chiq turadi)
# Kalit: https://console.anthropic.com
ANTHROPIC_API_KEY=""

# Docker compose sozlamalari (ixtiyoriy).
# Baza foydalanuvchisi va paroli — compose shulardan ulanish satrini quradi.
POSTGRES_USER="onebo"
POSTGRES_PASSWORD="onebo"
POSTGRES_DB="onebofx"
# Ilova qaysi portda ochilsin.
APP_PORT="3000"
# Tashqi baza yoki Redis ishlatilsa — compose ichidagilarning o'rniga.
COMPOSE_DATABASE_URL=""
COMPOSE_REDIS_URL=""

# Urinishlar chegarasi qayerda sanaladi (ixtiyoriy).
# Bo'sh bo'lsa — jarayon xotirasida: bitta serverda ishlaydigan ilova
# uchun yetarli. Bir nechta nusxada ishlatilsa shu yerga Redis manzili
# qo'yiladi, shunda chegara nusxalar soniga ko'paymaydi.
REDIS_URL=""

# Yuklangan skrinshotlar qayerda saqlanadi — diskda.
# Pastdagi S3 sozlansa bu e'tiborga olinmaydi.
UPLOAD_DIR="./uploads"

# --- S3 (ixtiyoriy). Qo'yilsa skrinshotlar diskka emas, obyekt
# --- saqlagichga yoziladi va ilova serverless'da ham ishlaydi.
# --- S3, Cloudflare R2, Backblaze B2 va MinIO — bitta protokol.
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# AWS uchun mintaqa (masalan eu-central-1), R2 uchun "auto".
S3_REGION="auto"
# R2 / B2 / MinIO manzili. AWS ishlatilsa bo'sh qoldiriladi.
# R2: https://<account_id>.r2.cloudflarestorage.com
S3_ENDPOINT=""
# Bucket nomi yo'lda kelsin (MinIO va mahalliy sinovlar uchun).
S3_FORCE_PATH_STYLE=""

# Iqtisodiy kalendar (ixtiyoriy — bo'lmasa brifingning iqtisodiy qismi chiqmaydi).
# actual, forecast va previous uchalasini beradigan provayder kerak.
ECONOMIC_API_KEY=""
ECONOMIC_API_URL="https://financialmodelingprep.com/stable/economic-calendar"

# Skrinshot o'qish va iqtisodiy tahlil uchun model (ixtiyoriy).
ANTHROPIC_MODEL="claude-sonnet-5"

# Haftalik hisobotni pochtaga jo'natish uchun (ixtiyoriy).
# Bo'lmasa PDF yuklab olish ishlaydi, jo'natish esa o'chiq turadi.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="ONEBO FX <no-reply@example.com>"

# Saytning tashqi manzili. To'lovdan keyin qaytish, pochtani tasdiqlash
# va parolni tiklash havolalari shundan yasaladi — bo'lmasa xat ketmaydi.
APP_URL="https://onebofx.uz"

# --- Muddati kelgan ishlarni tozalash (ixtiyoriy, lekin tavsiya etiladi).
# Qo'yilsa `/api/cron` manzili ochiladi va sutkasiga bir marta shunday
# chaqirilishi kerak:
#
#   curl -fsS -H "Authorization: Bearer $CRON_SECRET" https://<domen>/api/cron
#
# U o'chirish so'ralgan hisoblarni (30 kundan keyin), muddati tugagan
# namuna hisoblarni va eskirgan kalitlarni tozalaydi. Qo'yilmasa manzil
# umuman javob bermaydi (404), tozalash esa xodim paneli ochilganda
# bajariladi — ya'ni kamdan-kam.
CRON_SECRET=""

# --- Payme (ixtiyoriy). Sozlanmasa Payme tugmasi ishlamaydi,
# --- Click va kartaga o'tkazma ishlayveradi.
# Kassa identifikatori — Merchant kabinetidan.
PAYME_MERCHANT_ID=""
# Kassa kaliti. Merchant API chaqiruvlari shu bilan tekshiriladi.
PAYME_KEY=""
# Basic auth login — amalda "Paycom".
PAYME_LOGIN="Paycom"
# Sinov uchun: https://checkout.test.paycom.uz
PAYME_CHECKOUT_URL="https://checkout.paycom.uz"
# Payme so'raydigan manzil: https://<domen>/api/payme

# --- Click (ixtiyoriy)
CLICK_SERVICE_ID=""
CLICK_MERCHANT_ID=""
CLICK_SECRET_KEY=""
# Click so'raydigan manzillar:
#   Prepare  — https://<domen>/api/click/prepare
#   Complete — https://<domen>/api/click/complete

# --- Kartaga o'tkazma (provaydersiz to'lov)
MANUAL_CARD_NUMBER=""
MANUAL_CARD_HOLDER=""
MANUAL_CONTACT=""

# --- Uzum Bank (ixtiyoriy). Sozlanmasa tarif sahifasida Uzum tugmasi
# --- ko'rinmaydi, qolgan usullar ishlayveradi.
# Kassa identifikatori — Uzum beradi.
UZUM_SERVICE_ID=""
# Uzum bizning /api/uzum/* endpointlarimizga Basic auth bilan murojaat qiladi.
UZUM_USERNAME=""
UZUM_PASSWORD=""
# To'lov sahifasiga havola namunasi. Uzum bergan manzilga {payment_id}
# va {amount} (tiyinda) o'rinlarini qo'ying, masalan:
# https://checkout.example/pay?service=123&account={payment_id}&amount={amount}
UZUM_CHECKOUT_URL=""

# --- Huquqiy sahifalardagi rekvizitlar (ommaviy oferta va maxfiylik).
# --- To'ldirilmasa sahifada "to'ldirilmagan" belgisi ko'rinadi.
LEGAL_COMPANY=""
LEGAL_STIR=""
LEGAL_ADDRESS=""
LEGAL_EMAIL=""
LEGAL_PHONE=""
